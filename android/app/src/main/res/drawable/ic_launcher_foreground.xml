<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.65"
        android:scaleY="0.65"
        android:translateX="18.9"
        android:translateY="18.9">
        
        <!-- Outer Glowing Octagon Ring / Neural Node -->
        <path
            android:pathData="M54,20 L78,30 L88,54 L78,78 L54,88 L30,78 L20,54 L30,30 Z"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="20"
                    android:startY="20"
                    android:endX="88"
                    android:endY="88"
                    android:type="linear">
                    <item android:color="#A78BFA" android:offset="0.0" />
                    <item android:color="#06B6D4" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Inner Nexora Spark Core -->
        <path
            android:pathData="M54,26 C54,40 40,54 26,54 C40,54 54,68 54,82 C54,68 68,54 82,54 C68,54 54,40 54,26 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="26"
                    android:startY="26"
                    android:endX="82"
                    android:endY="82"
                    android:type="linear">
                    <item android:color="#FFFFFF" android:offset="0.0" />
                    <item android:color="#C4B5FD" android:offset="0.4" />
                    <item android:color="#8B5CF6" android:offset="0.8" />
                    <item android:color="#06B6D4" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Center Quantum Pulse Dot -->
        <path
            android:pathData="M54,54m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
