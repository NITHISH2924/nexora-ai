# ==============================================================================
# NEXORA AI - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Metadata
APP_NAME="NEXORA AI"
APP_ENV="production"
HOST="0.0.0.0"
PORT=8000
FRONTEND_URL="https://your-production-domain.com"
PRODUCTION_DOMAIN="your-production-domain.com"

# Security & Secrets (Must be generated with a strong 256-bit key in production)
JWT_SECRET="replace-with-a-cryptographically-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SECURE_COOKIES=true

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="https://your-production-domain.com,https://app.your-production-domain.com"

# Production Database & File Storage
DATABASE_PATH="data/nexora_prod.db"
UPLOAD_DIR="data/uploads"
MAX_FILE_SIZE_MB=20

# Executive Leadership & Platform Governance
OWNER_NAME="Nithish Kumar R"
CEO_NAME="Dhanushiya S"
OWNER_EMAIL="owner@nexora.ai"
CEO_EMAIL="ceo@nexora.ai"

# Rate Limiting Guardrails
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# Production SMTP Email Dispatch
EMAIL_FROM="NEXORA AI <no-reply@your-production-domain.com>"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="your-smtp-api-key"

# AI Provider API Keys (Server-Side Only - Never Exposed to Clients)
GEMINI_API_KEY="your-google-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GROQ_API_KEY="your-groq-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
TAVILY_API_KEY="your-tavily-search-api-key"
DEFAULT_AI_MODEL="gemini-1.5-flash"
